# Copie este arquivo para ".env" e preencha com os dados do SEU projeto Supabase
# (Project Settings > API no dashboard do Supabase). Nunca use a chave "service_role" aqui.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_CHAVE_ANON_PUBLICA

# Chave da IA para o chatbot (veja o passo 5 do README). Esta NÃO leva o
# prefixo VITE_ de propósito — ela fica só no servidor, nunca no navegador.
ANTHROPIC_API_KEY=SUA_CHAVE_DA_ANTHROPIC

# Chave opcional para gerar imagens ilustrativas de produto (Painel Empresário).
# Sem ela, o botão de descrição/dicas de foto (Anthropic) continua funcionando
# normalmente — só a imagem ilustrativa fica desativada.
OPENAI_API_KEY=SUA_CHAVE_DA_OPENAI
