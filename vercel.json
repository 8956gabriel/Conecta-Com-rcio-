{
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true
    }
  },
  "rewrites": [
    {
      "source": "/ivatuba",
      "destination": "/"
    },
    {
      "source": "/ivatuba/(.*)",
      "destination": "/"
    },
    {
      "source": "/fomento",
      "destination": "/"
    },
    {
      "source": "/fomento/(.*)",
      "destination": "/"
    },
    {
      "source": "/sala",
      "destination": "/"
    },
    {
      "source": "/sala/(.*)",
      "destination": "/"
    },
    {
      "source": "/acesso",
      "destination": "/"
    },
    {
      "source": "/agente",
      "destination": "/"
    },
    {
      "source": "/admin",
      "destination": "/"
    },
    {
      "source": "/entrar",
      "destination": "/"
    },
    {
      "source": "/demo",
      "destination": "/"
    },
    {
      "source": "/publico",
      "destination": "/"
    },
    {
      "source": "/atendente",
      "destination": "/"
    }
  ]
